{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(npm test *)",
      "Bash(npm run test:legacy)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck)",
      "Bash(npm run format:check)",
      "Bash(git status *)",
      "Bash(git diff *)"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash(git commit *)",
      "Bash(npm install *)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(git push *)"
    ]
  }
}